# Copy this file to .env. Never commit a real API key.
# For the hosted provider, set a key and choose an accessible model.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
OPENAI_BASE_URL=https://api.openai.com/v1

# Local generation: start Ollama and install this model first.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# Optional semantic retrieval: none, openai, or ollama.
# Upload documents again after changing the embedding provider/model.
EMBEDDING_PROVIDER=none
# Defaults: text-embedding-3-small for OpenAI; embeddinggemma for Ollama.
EMBEDDING_MODEL=

# Local SQLite workspace. Do not run two Atlas processes against one workspace.
ATLAS_DATA_DIR=data
ATLAS_DEMO=0
